;; 依存とソースパスは deps.edn を単一の情報源として参照する。bbin が生成する
;; ラッパーも :local/root 経由で deps.edn を読むため、ここで再宣言すると
;; 片方だけ更新されたときに CLI とタスクで別バージョンが走る。
{:deps {clojure-skills/lib {:local/root "."}}

 :bbin/bin {clj-skill {:main-opts ["-m" "clojure-skill.main"]}}

 :tasks
 {:requires ([babashka.fs :as fs]
             [clojure.edn :as edn])

  -tools {:doc "Tool name -> main-opts, read from :bbin/bin so it is declared once"
          :task (:bbin/bin (edn/read-string (slurp "bb.edn")))}

  ;; A quote in a map value would be read as an extra element here: bb reads
  ;; bb.edn as EDN, where ' is not a reader macro.
  -legacy-tools {:doc "Binaries from before the single-binary rewrite"
                 :task ["clj-paren-repair-claude-hook" "clj-nrepl-eval" "clj-paren-repair"
                        "clj-lsp-bridge" "clj-lsp-client"]}

  -remove-legacy {:doc "Uninstall any pre-rewrite binaries still on PATH"
                  :depends [-legacy-tools]
                  :task (doseq [tool-name -legacy-tools]
                          (shell {:continue true :out :string :err :string}
                                 "bbin" "uninstall" tool-name))}

  install {:doc "Install the CLI (paren-repair hooks are opt-in; use `bb install-hooks`)"
           :depends [-tools -remove-legacy]
           :task (do
                   (doseq [[tool-name {:keys [main-opts]}] -tools]
                     (println (str "Installing " tool-name "..."))
                     (shell "bbin" "install" "." "--as" (str tool-name)
                            "--main-opts" (pr-str main-opts)))
                   (println)
                   (shell "bb" "doctor"))}

  uninstall {:doc "Uninstall the CLI and remove hooks"
             :depends [-tools -remove-legacy]
             :task (do
                     (require 'clojure-skill.claude-settings)
                     ((resolve 'clojure-skill.claude-settings/uninstall-hooks!))
                     (doseq [tool-name (keys -tools)]
                       (println (str "Uninstalling " tool-name "..."))
                       (shell {:continue true} "bbin" "uninstall" (str tool-name)))
                     (println "\nUninstalled."))}

  install-hooks {:doc "Register paren-repair hooks in ~/.claude/settings.json (opt-in)"
                 :task (do
                         (require 'clojure-skill.claude-settings)
                         ((resolve 'clojure-skill.claude-settings/install-hooks!)))}

  uninstall-hooks {:doc "Remove paren-repair hooks from ~/.claude/settings.json"
                   :task (do
                           (require 'clojure-skill.claude-settings)
                           ((resolve 'clojure-skill.claude-settings/uninstall-hooks!)))}

  doctor {:doc "Report which skill features are available in this environment"
          :task (do (require 'clojure-skill.doctor)
                    ((resolve 'clojure-skill.doctor/-main)))}

  test {:doc "Run tests"
        :extra-paths ["test"]
        :task (do (require 'clojure-skill.test-runner)
                  ((resolve 'clojure-skill.test-runner/-main)))}}}
